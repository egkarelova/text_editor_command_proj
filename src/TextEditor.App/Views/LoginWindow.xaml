<Window x:Class="TextEditor.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text Editor — Вход"
        Height="460" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Text Editor"
                   FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <TabControl Grid.Row="1" x:Name="Tabs">
            <!-- ВХОД -->
            <TabItem Header="Вход">
                <StackPanel Margin="16">
                    <TextBlock Text="Логин"/>
                    <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>

                    <TextBlock Text="Пароль"/>
                    <PasswordBox x:Name="LoginPasswordBox" PasswordChanged="LoginPasswordBox_Changed" Margin="0,4,0,12"/>

                    <Button Content="Войти" Command="{Binding LoginCommand}"
                            IsDefault="True" Height="32" Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- РЕГИСТРАЦИЯ -->
            <TabItem Header="Регистрация">
                <StackPanel Margin="16">
                    <TextBlock Text="Логин"/>
                    <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>

                    <TextBlock Text="Пароль (мин. 6 символов)"/>
                    <PasswordBox x:Name="RegisterPasswordBox" PasswordChanged="RegisterPasswordBox_Changed" Margin="0,4,0,12"/>

                    <TextBlock Text="Повторите пароль"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" PasswordChanged="ConfirmPasswordBox_Changed" Margin="0,4,0,12"/>

                    <Button Content="Зарегистрироваться" Command="{Binding RegisterCommand}"
                            Height="32" Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C"
                       TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <Button Content="Войти как гость" Command="{Binding GuestCommand}"
                    Height="32" Margin="0,8,0,0"/>

            <TextBlock Text="Гостевые документы видны всем зарегистрированным пользователям"
                       FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</Window>