<Window x:Class="TextEditor.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About" Height="260" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Text Editor" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="v0.1.0 (Sprint 1 — walking skeleton)" Margin="0,4,0,12"/>
        <TextBlock TextWrapping="Wrap"
                   Text="Учебный проект по командной разработке. WPF + EF Core + SQLite."/>
        <TextBlock Text="Команда:" FontWeight="SemiBold" Margin="0,12,0,4"/>
        <TextBlock Text="Lead, Dev A, Dev B, Dev C, Dev D, Dev E"/>
        <Button Content="OK" Width="80" HorizontalAlignment="Right" Margin="0,16,0,0"
                IsDefault="True" Click="Ok_Click"/>
    </StackPanel>
</Window>